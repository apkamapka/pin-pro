+            </div>
+            <div className="flex items-center gap-1">
+              <button
+                onClick={(e) => handleRemove(e, profile)}
+                className="rounded-lg p-2 text-muted-foreground hover:bg-destructive/10 hover:text-destructive"
+                title={t.profileDelete}
+              >
