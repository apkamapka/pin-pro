From ff45f56260fa3ba7e7b4d6f6aacae0112ad9f096 Mon Sep 17 00:00:00 2001
From: Claude <claude@anthropic.com>
Date: Fri, 15 May 2026 21:04:51 +0000
Subject: [PATCH] fix: use akApp SVG logo in ProfileSelect footer

- Added akapp-logo.svg to public/
- ProfileSelect footer now shows akApp SVG logo instead of text
- Increased bottom padding (pb-8) for better spacing
---
 public/akapp-logo.svg            |  9 +++++++++
 src/components/ProfileSelect.tsx | 10 +++++++---
 2 files changed, 16 insertions(+), 3 deletions(-)
 create mode 100644 public/akapp-logo.svg

diff --git a/public/akapp-logo.svg b/public/akapp-logo.svg
new file mode 100644
index 0000000..0b1315f
--- /dev/null
+++ b/public/akapp-logo.svg
@@ -0,0 +1,9 @@
+<svg version="1.2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
+	<title>Projekt bez nazwy (24)</title>
+	<defs>
+		<image  width="512" height="512" id="img1" href="data:image/png;base64,"/>
+	</defs>
+	<style>
+	</style>
+	<use id="Background" href="#img1" x="0" y="0"/>
+</svg>
\ No newline at end of file
diff --git a/src/components/ProfileSelect.tsx b/src/components/ProfileSelect.tsx
index 7e66e9d..527cebe 100644
--- a/src/components/ProfileSelect.tsx
+++ b/src/components/ProfileSelect.tsx
@@ -296,15 +296,19 @@ export function ProfileSelect() {
       </div>
 
       {/* Footer — "stworzone przez akApp" */}
-      <div className="mt-auto pt-10 pb-6 flex flex-col items-center gap-3 text-xs text-muted-foreground">
+      <div className="mt-auto pt-10 pb-8 flex flex-col items-center gap-2 text-xs text-muted-foreground">
         <span>{t.madeBy}</span>
         <a
           href="https://akappstudio.pl/"
           target="_blank"
           rel="noopener noreferrer"
-          className="text-sm font-semibold text-foreground transition-opacity hover:opacity-80"
+          className="transition-opacity hover:opacity-80"
         >
-          akApp
+          <img
+            src="/akapp-logo.svg"
+            alt="akApp"
+            className="h-10 w-10"
+          />
         </a>
       </div>
     </div>
-- 
2.43.0

